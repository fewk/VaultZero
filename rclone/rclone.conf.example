# ==============================================================================
# Rclone Configuration Template for Cloudflare R2
#
# Usage:
# 1. Create an R2 bucket in the Cloudflare Dashboard (e.g., named 'vaultwarden-backup')
# 2. Generate an R2 API Token with 'Object Read & Write' permissions
# 3. Copy this template to rclone/rclone.conf:
#      cp rclone/rclone.conf.example rclone/rclone.conf
#      chmod 600 rclone/rclone.conf
# 4. Replace placeholder credentials below with your Cloudflare R2 details
# ==============================================================================

[r2]
type = s3
provider = Cloudflare
access_key_id = <CLOUDFLARE_R2_ACCESS_KEY_ID>
secret_access_key = <CLOUDFLARE_R2_SECRET_ACCESS_KEY>
endpoint = https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
acl = private
