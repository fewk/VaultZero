# ==============================================================================
# VaultZero Environment Configuration Template / 环境变量配置模板
#
# Usage / 使用方法:
# Copy this file to .env and configure secrets before starting services:
# 复制此文件到 /opt/vaultwarden/.env 并配置密钥：
#   cp .env.example /opt/vaultwarden/.env && chmod 0600 /opt/vaultwarden/.env
# ==============================================================================

# Public HTTPS domain handled by Cloudflare Tunnel (e.g., https://vault.example.com)
# 由 Cloudflare 隧道分配的完整 HTTPS 访问域名 (例如: https://pw.yourdomain.com)
DOMAIN=https://vault.yourdomain.com

# Admin Panel Token (Optional, leave blank to disable /admin)
# 管理后台密码 Token (可选；若留空则禁用 /admin 管理后台以获得最高安全性)
# 强烈建议: 使用 Argon2 PHC 哈希替代明文密码。
# 生成哈希命令 (在虚拟机中执行):
#   docker run --rm -it vaultwarden/server:latest /vaultwarden hash
# 注意: 在 .env 文件中请直接粘贴生成的原始哈希（无需对 $ 符号转义）。
ADMIN_TOKEN=

# Password for AES encryption of backup zip archives generated by vaultwarden-backup
# 异地容灾备份的 AES 加密密码（用于加密导出的 .zip 备份包，务必妥善保管）
BACKUP_ZIP_PASS=replace_with_a_very_strong_random_password

# Rclone destination name matching the remote configured in rclone/rclone.conf
# 对应 rclone/rclone.conf 中配置的远端名称（默认 r2）
RCLONE_REMOTE_NAME=r2

# Rclone target bucket or directory path
# 对应 R2 存储桶名及保存路径
RCLONE_REMOTE_DIR=/vaultwarden-backup

# Optional Secondary Remote Destination (e.g., WebDAV / InfiniCLOUD / NAS)
# 可选的第二备份远端（如 WebDAV / InfiniCLOUD / 坚果云 / 群晖，取消注释即可启用双云并发容灾）
# RCLONE_REMOTE_NAME_1=webdav
# RCLONE_REMOTE_DIR_1=/vaultwarden-backup

# System and backup timezone / 系统与备份服务时区
TZ=Asia/Shanghai

# Optional Telegram backup alerts (uncomment to enable)
# 可选的 Telegram 备份结果推送通知（取消注释以启用）
# TG_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TG_CHAT_ID=-100123456789
